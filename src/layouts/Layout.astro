---
import "../styles/global.css";
import ParticlesBackground from "../components/3d/ParticlesBackground.astro";

const {
  title = "Ridlo Abdullah Ulinnuha - Software Engineer",
  description = "Software engineering portfolio for Ridlo Abdullah Ulinnuha.",
  siteUrl = "https://ridlo543.github.io/ridlo-portfolio-profile/",
  socialImage = "/android-chrome-512x512.png",
  noindex = false,
} = Astro.props;

const normalizedSiteUrl = siteUrl.endsWith("/") ? siteUrl : `${siteUrl}/`;
const toAbsoluteUrl = (path: string) => {
  if (/^https?:\/\//.test(path)) return path;
  return new URL(path.replace(/^\/+/, ""), normalizedSiteUrl).toString();
};
const canonicalUrl = toAbsoluteUrl(Astro.url.pathname);
const socialImageUrl = toAbsoluteUrl(socialImage);
---

<!doctype html>
<html lang="id" data-lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Ridlo Abdullah Ulinnuha" />
    <meta
      name="theme-color"
      content="#111827"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f6f7fb"
      media="(prefers-color-scheme: light)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Ridlo Abdullah Ulinnuha Portfolio" />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="Ridlo Abdullah Ulinnuha portfolio icon"
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (() => {
        // Theme init
        const themeKey = "portfolio-theme";
        const defaultTheme = "dark";
        let theme = defaultTheme;
        try {
          const storedTheme = localStorage.getItem(themeKey);
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme;
          }
        } catch {}

        const root = document.documentElement;
        root.dataset.themeMode = theme;
        root.dataset.theme = theme;
        root.classList.remove("dark", "light");
        root.classList.add(theme);

        // Language init (default: id)
        const langKey = "portfolio-lang";
        const defaultLang = "id";
        let lang = defaultLang;
        try {
          const storedLang = localStorage.getItem(langKey);
          if (storedLang === "id" || storedLang === "en") {
            lang = storedLang;
          }
        } catch {}

        root.dataset.lang = lang;
        root.lang = lang;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-[var(--app-bg)] text-[var(--app-text)] min-h-screen relative overflow-x-hidden selection:bg-emerald-500/20 selection:text-emerald-300">
    <ParticlesBackground />
    <div class="relative z-10">
      <slot />
    </div>

    <script>
      // 3D Card Tilt & Specular Glare System
      function initCardTilt() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (window.innerWidth < 768) return;

        const cards = document.querySelectorAll<HTMLElement>("[data-tilt-card]");

        cards.forEach((card) => {
          card.addEventListener("mousemove", (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((y - centerY) / centerY) * -3.5;
            const rotateY = ((x - centerX) / centerX) * 3.5;

            card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(3px)`;
            card.style.setProperty("--mouse-x", `${x.toFixed(1)}px`);
            card.style.setProperty("--mouse-y", `${y.toFixed(1)}px`);
          });

          card.addEventListener("mouseleave", () => {
            card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)";
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCardTilt);
      } else {
        initCardTilt();
      }
    </script>
  </body>
</html>
