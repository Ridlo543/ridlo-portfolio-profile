---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/home/bento/BentoCard.astro";
import IntroCard from "../components/home/bento/IntroCard.astro";
import AboutCard from "../components/home/bento/AboutCard.astro";
import TechnologyCard from "../components/home/bento/TechnologyCard.astro";
import ProjectsCard from "../components/home/bento/ProjectsCard.astro";
import TimeCard from "../components/home/bento/TimeCard.astro";
import QuoteCard from "../components/home/bento/QuoteCard.astro";
import StudyCard from "../components/home/bento/StudyCard.astro";
import ExperienceCard from "../components/home/bento/ExperienceCard.astro";
import ReadsCard from "../components/home/bento/ReadsCard.astro";
import ContactCard from "../components/home/bento/ContactCard.astro";
---

<Layout
  title="Ridlo Abdullah Ulinnuha - Software Engineer"
  description="Ridlo Abdullah Ulinnuha's software engineering portfolio covering web applications, APIs, databases, product interfaces, ML integration, and selected projects."
>
  <main class="bento-theme min-h-screen px-3 py-4 sm:px-4 md:px-6 md:py-6">
    <div class="bento-shell mx-auto w-full max-w-7xl">
      <div class="bento-top">
        <BentoCard className="bento-card--menu">
          <IntroCard />
        </BentoCard>

        <BentoCard title="About me">
          <AboutCard />
        </BentoCard>
      </div>

      <BentoCard title="Technologies">
        <TechnologyCard />
      </BentoCard>

      <div class="bento-board">
        <div class="bento-stack">
          <BentoCard title="Projects">
            <ProjectsCard />
          </BentoCard>
        </div>

        <div class="bento-stack">
          <BentoCard title="Your time">
            <TimeCard label="Local time" helper="Your browser timezone" />
          </BentoCard>

          <BentoCard title="Experience">
            <ExperienceCard />
          </BentoCard>
        </div>

        <div class="bento-stack">
          <BentoCard title="My time">
            <TimeCard
              label="Jakarta time"
              helper="Asia/Jakarta"
              timezone="Asia/Jakarta"
            />
          </BentoCard>

          <BentoCard title="Education and Certifications">
            <StudyCard />
          </BentoCard>
        </div>

        <div class="bento-stack">
          <BentoCard>
            <QuoteCard />
          </BentoCard>

          <BentoCard title="Current Focus">
            <ReadsCard />
          </BentoCard>
        </div>
      </div>

      <BentoCard title="Contact">
        <ContactCard />
      </BentoCard>
    </div>
  </main>
</Layout>
