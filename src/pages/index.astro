---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/home/bento/BentoCard.astro";
import IntroCard from "../components/home/bento/IntroCard.astro";
import AboutCard from "../components/home/bento/AboutCard.astro";
import TechnologyCard from "../components/home/bento/TechnologyCard.astro";
import ProjectsCard from "../components/home/bento/ProjectsCard.astro";
import StudyCard from "../components/home/bento/StudyCard.astro";
import ExperienceCard from "../components/home/bento/ExperienceCard.astro";
import { ui, defaultLang } from "../i18n/ui";

const t = ui[defaultLang];
---

<Layout
  title="Ridlo Abdullah Ulinnuha - Software Engineer"
  description="Software Engineer portfolio of Ridlo Abdullah Ulinnuha. Experienced in production Laravel systems (177+ PRs), MySQL query optimization, applied machine learning, and modern web applications."
>
  <main class="bento-theme min-h-screen px-3 py-2.5 sm:px-4 sm:py-3.5 md:px-6 md:py-4">
    <div class="bento-shell mx-auto w-full max-w-7xl">
      <!-- ROW 1: Identity & Highlights -->
      <div class="bento-top">
        <BentoCard className="bento-card--intro">
          <IntroCard />
        </BentoCard>

        <BentoCard titleKey="about.title">
          <AboutCard />
        </BentoCard>
      </div>

      <!-- ROW 2: Core Technologies -->
      <BentoCard titleKey="tech.title">
        <TechnologyCard />
      </BentoCard>

      <!-- ROW 3: Deep Dives -->
      <div class="bento-board bento-board--trio">
        <BentoCard titleKey="projects.title">
          <ProjectsCard />
        </BentoCard>

        <BentoCard titleKey="experience.title">
          <ExperienceCard />
        </BentoCard>

        <BentoCard titleKey="study.title">
          <StudyCard />
        </BentoCard>
      </div>

      <!-- Footer -->
      <footer class="flex flex-col sm:flex-row items-center justify-between gap-1 pt-1 text-[0.68rem] text-[var(--app-text-soft)]">
        <span data-i18n="footer.copyright" data-i18n-year={String(new Date().getFullYear())}>
          {t["footer.copyright"].replace("{year}", String(new Date().getFullYear()))}
        </span>
        <span class="font-mono" data-i18n="footer.location">{t["footer.location"]}</span>
      </footer>
    </div>
  </main>
</Layout>
