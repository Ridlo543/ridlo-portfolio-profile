---
// One screen on desktop (identity left, tabbed work right); a single column on phones.
import Layout from "../layouts/Layout.astro";
import LanguageSwitch from "../components/home/bento/LanguageSwitch.astro";
import ThemeSwitch from "../components/home/bento/ThemeSwitch.astro";
import { bilingualProjects, bilingualExperiences, bilingualEducation } from "../i18n/content";
import { certificates } from "../data/certificateData.js";
import { ui, defaultLang } from "../i18n/ui";
import { FaGithub, FaLinkedinIn } from "react-icons/fa6";
import ProjectCard from "../components/home/ProjectCard.astro";
import CertCard from "../components/home/CertCard.astro";
import CloseButton from "../components/home/CloseButton.astro";
import MiniShinobi from "../components/MiniShinobi.astro";

const t = ui[defaultLang];
const lang = defaultLang;

const featuredProjects = bilingualProjects.slice(0, 4);
// Four certificates that say the most about the work, in this order.
const featuredTitles = [
  "Alibaba Cloud Certified Developers",
  "DeepLearning.AI TensorFlow Developer Certificate",
  "Bangkit 2024 Machine Learning Completion",
  "Back-End Application Beginner",
];
const featuredCerts = featuredTitles.flatMap((title) => certificates.filter((c) => c.title === title));

// Logos live in public/icons/tech. "ink" logos are near-black and get inverted on the dark theme.
type Tool = { name: string; logo?: string; ink?: boolean; href?: string; own?: boolean };
type GroupKey = "skills.ai" | "skills.web" | "skills.ml" | "skills.ops" | "skills.mobile";
const stack: { key: GroupKey; wide?: boolean; tools: Tool[] }[] = [
  {
    key: "skills.ai",
    wide: true,
    tools: [
      { name: "Claude Code", logo: "claude" },
      { name: "OpenCode", logo: "opencode", ink: true },
      { name: "Oh My Pi" },
      { name: "Hermes Agent" },
      { name: "MCP", logo: "mcp", ink: true },
      { name: "systemone", logo: "github", ink: true, href: "https://github.com/Ridlo543/systemone-judge", own: true },
    ],
  },
  {
    key: "skills.web",
    tools: [
      { name: "Laravel", logo: "laravel" },
      { name: "PHP", logo: "php" },
      { name: "MySQL", logo: "mysql", ink: true },
      { name: "PostgreSQL", logo: "postgres" },
      { name: "Vue", logo: "vue" },
      { name: "Next.js", logo: "nextjs", ink: true },
      { name: "React", logo: "react" },
      { name: "TypeScript", logo: "typescript" },
      { name: "JavaScript", logo: "javascript" },
      { name: "Astro", logo: "astro", ink: true },
      { name: "Tailwind CSS", logo: "tailwindcss" },
      { name: "Drizzle ORM", logo: "drizzle" },
      { name: "Filament", logo: "filament" },
    ],
  },
  {
    key: "skills.ml",
    tools: [
      { name: "Python", logo: "python" },
      { name: "PyTorch", logo: "pytorch" },
      { name: "TensorFlow", logo: "tensorflow" },
      { name: "YOLO", logo: "ultralytics", ink: true },
      { name: "OpenCV", logo: "opencv" },
      { name: "scikit-learn", logo: "scikit-learn" },
      { name: "Pandas", logo: "pandas", ink: true },
      { name: "NumPy", logo: "numpy" },
      { name: "Jupyter", logo: "jupyter" },
      { name: "FastAPI", logo: "fastapi" },
      { name: "Flask", logo: "flask", ink: true },
      { name: "Gemini", logo: "gemini" },
      { name: "Vertex AI", logo: "google-cloud" },
      { name: "Hugging Face", logo: "huggingface" },
      { name: "RAG" },
    ],
  },
  {
    key: "skills.ops",
    tools: [
      { name: "Linux VPS", logo: "linux-tux" },
      { name: "Docker", logo: "docker" },
      { name: "Nginx", logo: "nginx" },
      { name: "Git", logo: "git" },
      { name: "GitHub", logo: "github", ink: true },
      { name: "CI/CD" },
      { name: "Tencent Cloud", logo: "tencent-cloud" },
      { name: "Oracle Cloud", logo: "oracle-cloud" },
      { name: "Alibaba Cloud", logo: "alibaba-cloud" },
      { name: "Vercel", logo: "vercel", ink: true },
    ],
  },
  {
    key: "skills.mobile",
    tools: [
      { name: "Kotlin", logo: "kotlin" },
      { name: "Jetpack Compose", logo: "jetpack-compose" },
      { name: "Android", logo: "android" },
      { name: "Flutter", logo: "flutter" },
      { name: "Java", logo: "java" },
      { name: "Playwright", logo: "playwright" },
      { name: "WhatsApp API", logo: "whatsapp" },
    ],
  },
];

const quietBtn =
  "sakuga-btn-secondary w-full py-2.5 text-sm font-semibold cursor-pointer";
const tabBase =
  "workspace-tab-btn relative z-10 inline-flex items-baseline gap-1.5 pb-2.5 pt-0.5 transition-colors cursor-pointer shrink-0";
const metrics = [
  { value: "241+", key: "about.metric1.desc" as const },
  { value: t["about.metric4.value"], valueKey: "about.metric4.value" as const, key: "about.metric4.desc" as const },
  { value: "110+", key: "about.metric2.desc" as const },
  { value: "3.81", key: "about.metric3.desc" as const },
];
---

<Layout
  title="Ridlo Abdullah Ulinnuha - Software Engineer"
  description="Software engineer for web, machine learning and automation. 241+ merged pull requests on Neo Edukasi, a tutoring platform with 20,000+ registered users; AinyStudy, a RAG tutor; and thesis research on latent watermarks."
>
  <main class="w-full max-w-7xl mx-auto p-4 sm:p-6 lg:px-8 lg:py-5 [@media(min-height:760px)]:lg:py-7 lg:h-screen lg:overflow-hidden relative z-10 grid lg:grid-cols-12 gap-6 lg:gap-10 items-stretch">
    <aside class="min-w-0 lg:col-span-5 flex flex-col gap-3 [@media(min-height:760px)]:gap-5 lg:overflow-y-auto lg:pr-2">
      <div class="flex items-center justify-between gap-3 pb-2.5 border-b border-[var(--app-border)] shrink-0">
        <p class="min-w-0 inline-flex items-center gap-2 text-xs text-[var(--app-text-muted)]">
          <span class="h-2 w-2 rounded-full bg-[var(--app-pop)]" aria-hidden="true"></span>
          <span data-i18n="intro.available">{t["intro.available"]}</span>
        </p>
        <div class="flex items-center gap-2">
          <LanguageSwitch />
          <ThemeSwitch />
        </div>
      </div>

      <div class="lg:mt-1 [@media(min-height:760px)]:lg:mt-3 lg:mb-auto space-y-3 [@media(min-height:760px)]:space-y-5">
        <div class="relative pt-12 space-y-1.5 [@media(min-height:760px)]:space-y-2">
          <MiniShinobi />
          <h1 class="text-3xl sm:text-4xl [@media(min-height:760px)]:text-[2.65rem] font-extrabold text-[var(--app-text)] tracking-tight leading-[1.06]">
            Ridlo Abdullah Ulinnuha
          </h1>
          <p class="text-sm sm:text-base font-medium text-[var(--app-accent)]" data-i18n="intro.subtitle">
            {t["intro.subtitle"]}
          </p>
          <p class="text-sm leading-snug [@media(min-height:760px)]:leading-relaxed text-[var(--app-text-muted)] max-w-[52ch]" data-i18n="intro.bio">
            {t["intro.bio"]}
          </p>
        </div>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-2.5 [@media(min-height:760px)]:gap-y-4 border-t border-[var(--app-border)] pt-3.5 [@media(min-height:760px)]:pt-5">
          {metrics.map((m) => (
            <div>
              <dt class="sr-only" data-i18n={m.key}>{t[m.key]}</dt>
              <dd>
                <span class="block font-mono text-2xl [@media(min-height:760px)]:text-3xl font-bold tracking-tight text-[var(--app-text)]" data-i18n={m.valueKey}>{m.value}</span>
                <span class="block text-xs text-[var(--app-text-muted)] mt-0.5" aria-hidden="true" data-i18n={m.key}>{t[m.key]}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="space-y-3 shrink-0">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/cv/ridlo-software-engineer-en.pdf"
            download
            data-sakuga-btn="primary"
            class="sakuga-btn-primary flex-1 inline-flex items-center justify-center font-bold px-3 py-2 text-sm"
            data-i18n="cv.en"
          >{t["cv.en"]}</a>
          <a
            href="/cv/ridlo-software-engineer-id.pdf"
            download
            data-sakuga-btn="secondary"
            class="sakuga-btn-secondary flex-1 inline-flex items-center justify-center font-semibold px-3 py-2 text-sm"
            data-i18n="cv.id"
          >{t["cv.id"]}</a>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-[var(--app-text-muted)]">
          <div class="flex items-center gap-4">
            <a href="https://github.com/Ridlo543" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[var(--app-accent)] transition-colors">
              <FaGithub className="h-4 w-4" />
              <span>GitHub</span>
            </a>
            <a href="https://www.linkedin.com/in/ridlo-abdullah-ulinnuha/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[var(--app-accent)] transition-colors">
              <FaLinkedinIn className="h-4 w-4" />
              <span>LinkedIn</span>
            </a>
            <a href="mailto:ridloabdullahulinnuha543@gmail.com" class="hover:text-[var(--app-accent)] transition-colors" data-i18n="intro.email">{t["intro.email"]}</a>
          </div>
          <span class="text-xs text-[var(--app-text-soft)]" data-i18n="intro.shortLocation">{t["intro.shortLocation"]}</span>
        </div>
      </div>
    </aside>

    <section class="sakuga-panel min-w-0 lg:col-span-7 flex flex-col h-full bg-[var(--app-surface)]/95 backdrop-blur-md p-4 sm:p-5 lg:overflow-hidden relative">
      <nav class="relative flex items-center gap-5 border-b-[1.5px] border-[var(--app-border)] text-sm shrink-0 overflow-x-auto overflow-y-hidden" data-tab-nav data-i18n-aria="nav.ariaLabel" aria-label={t["nav.ariaLabel"]}>
        <span data-tab-indicator aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-[3px] rounded-full bg-[var(--app-pop)]"></span>
        <button type="button" data-tab-btn="projects" aria-pressed="true" class={`${tabBase} font-bold text-[var(--app-text)]`}>
          <span data-i18n="nav.projects">{t["nav.projects"]}</span>
          <span class="font-mono text-xs text-[var(--app-pop)]">{bilingualProjects.length}</span>
        </button>
        <button type="button" data-tab-btn="experience" aria-pressed="false" class={`${tabBase} font-medium text-[var(--app-text-muted)] hover:text-[var(--app-text)]`}>
          <span data-i18n="nav.experience">{t["nav.experience"]}</span>
        </button>
        <button type="button" data-tab-btn="credentials" aria-pressed="false" class={`${tabBase} font-medium text-[var(--app-text-muted)] hover:text-[var(--app-text)]`}>
          <span data-i18n="nav.credentials">{t["nav.credentials"]}</span>
          <span class="font-mono text-xs text-[var(--app-text-soft)]">{certificates.length}</span>
        </button>
        <button type="button" data-tab-btn="stack" aria-pressed="false" class={`${tabBase} font-medium text-[var(--app-text-muted)] hover:text-[var(--app-text)]`}>
          <span data-i18n="nav.skills">{t["nav.skills"]}</span>
        </button>
      </nav>

      <div class="flex-1 lg:overflow-y-auto mt-4 pr-1.5">
        <div id="tab-panel-projects" class="space-y-3">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
          <button id="btn-open-projects-modal" type="button" data-sakuga-btn="secondary" class={quietBtn} data-i18n="projects.viewAllBtn" data-i18n-count={bilingualProjects.length}>
            {t["projects.viewAllBtn"].replace("{count}", String(bilingualProjects.length))}
          </button>
        </div>

        <div id="tab-panel-experience" class="hidden">
          <ol class="space-y-5 pl-4 border-l border-[var(--app-border)] ml-1">
            {bilingualExperiences.map((exp) => (
              <li class="relative space-y-1" data-experience-item={exp.id}>
                <span class="absolute -left-[21px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-[var(--app-pop)] bg-[var(--app-surface)]" aria-hidden="true"></span>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 text-xs">
                  <span class="font-medium text-[var(--app-accent)]" data-exp-field="badge">{exp.badge[lang]}</span>
                  <span class="font-mono text-[var(--app-text-soft)]" data-exp-field="time">{exp.time[lang]}</span>
                </div>
                <h3 class="text-base font-semibold text-[var(--app-text)]" data-exp-field="role">{exp.role[lang]}</h3>
                <p class="text-xs text-[var(--app-text-soft)]">{exp.organization} · {exp.location}</p>
                <p class="text-sm text-[var(--app-text-muted)] leading-relaxed pt-0.5" data-exp-field="description">{exp.description[lang]}</p>
              </li>
            ))}
          </ol>
        </div>

        <div id="tab-panel-credentials" class="hidden space-y-5">
          <div class="p-4 rounded-[16px] border-[1.5px] border-[var(--app-border)] bg-[var(--app-surface-raised)]/75 space-y-1.5" data-education-card>
            <div class="flex items-start justify-between gap-3">
              <div>
                <span class="text-xs font-medium text-[var(--app-accent)]" data-i18n="edu.degree">{t["edu.degree"]}</span>
                <h3 class="text-base font-semibold text-[var(--app-text)] mt-0.5" data-edu-field="title">{bilingualEducation.title[lang]}</h3>
                <p class="text-xs text-[var(--app-text-soft)]">
                  <span data-edu-field="institution">{bilingualEducation.institution[lang]}</span>
                  <span> · </span>
                  <span data-edu-field="period">{bilingualEducation.period[lang]}</span>
                </p>
              </div>
              <span class="font-mono text-sm font-semibold text-[var(--app-text)] whitespace-nowrap" data-edu-field="gpa">{bilingualEducation.gpa[lang]}</span>
            </div>
            <p class="text-sm text-[var(--app-text-muted)] leading-relaxed pt-1" data-edu-field="description">{bilingualEducation.description[lang]}</p>
          </div>

          <div class="space-y-2.5">
            <div class="flex items-baseline justify-between text-xs text-[var(--app-text-soft)]">
              <h3 class="text-sm font-semibold text-[var(--app-text)]" data-i18n="certs.heading">{t["certs.heading"]}</h3>
              <span data-i18n="certs.count" data-i18n-count={certificates.length}>{t["certs.count"].replace("{count}", String(certificates.length))}</span>
            </div>
            <div class="grid sm:grid-cols-2 gap-2.5">
              {featuredCerts.map((cert) => <CertCard cert={cert} />)}
            </div>
            <button id="btn-open-certs-modal" type="button" data-sakuga-btn="secondary" class={quietBtn} data-i18n="certs.viewAllBtn" data-i18n-count={certificates.length}>
              {t["certs.viewAllBtn"].replace("{count}", String(certificates.length))}
            </button>
          </div>
        </div>

        <div id="tab-panel-stack" class="hidden">
          <div class="grid sm:grid-cols-2 gap-3">
            {stack.map((group) => (
              <div class:list={["p-4 rounded-[16px] border-[1.5px] border-[var(--app-border)] bg-[var(--app-surface-raised)]/75 space-y-3", group.wide && "sm:col-span-2"]}>
                <h3 class="text-sm font-semibold text-[var(--app-text)]" data-i18n={group.key}>{t[group.key]}</h3>
                <ul class="flex flex-wrap gap-1.5">
                  {group.tools.map((tool) => {
                    const Tag = tool.href ? "a" : "span";
                    return (
                      <li>
                        <Tag
                          href={tool.href}
                          target={tool.href ? "_blank" : undefined}
                          rel={tool.href ? "noopener noreferrer" : undefined}
                          class:list={[
                            "inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-[var(--app-border)] bg-[var(--app-surface)] px-2.5 py-1 text-xs text-[var(--app-text)]",
                            tool.href && "hover:border-[var(--app-accent)] transition-colors",
                          ]}
                        >
                          {tool.logo && (
                            <img src={`/icons/tech/${tool.logo}.svg`} alt="" width="16" height="16" loading="lazy" class:list={["h-4 w-4 object-contain", tool.ink && "logo-ink"]} />
                          )}
                          <span>{tool.name}</span>
                          {tool.own && <span class="text-[var(--app-accent)]" data-i18n="skills.own">{t["skills.own"]}</span>}
                        </Tag>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <dialog id="modal-all-projects" aria-labelledby="modal-projects-title" class="modal-shell p-0 rounded-[18px] border-[1.5px] border-[var(--app-border-strong)] bg-[var(--app-surface)] text-[var(--app-text)] shadow-[6px_7px_0_var(--app-shade)] max-w-4xl w-[92vw] max-h-[88vh]">
    <div class="p-4 sm:p-5 border-b border-[var(--app-border)] flex items-center justify-between gap-4 sticky top-0 bg-[var(--app-surface)] z-10">
      <div>
        <h2 id="modal-projects-title" class="text-lg font-semibold" data-i18n="projects.modalHeaderTitle">{t["projects.modalHeaderTitle"]}</h2>
        <p class="text-sm text-[var(--app-text-muted)] mt-0.5" data-i18n="projects.modalHeaderDesc">{t["projects.modalHeaderDesc"]}</p>
      </div>
      <CloseButton id="btn-close-projects-modal" />
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto max-h-[calc(88vh-88px)] space-y-3">
      {bilingualProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </dialog>

  <dialog id="modal-all-certs" aria-labelledby="modal-certs-title" class="modal-shell p-0 rounded-[18px] border-[1.5px] border-[var(--app-border-strong)] bg-[var(--app-surface)] text-[var(--app-text)] shadow-[6px_7px_0_var(--app-shade)] max-w-4xl w-[92vw] max-h-[88vh]">
    <div class="p-4 sm:p-5 border-b border-[var(--app-border)] flex items-center justify-between gap-4 sticky top-0 bg-[var(--app-surface)] z-10">
      <div>
        <h2 id="modal-certs-title" class="text-lg font-semibold" data-i18n="certs.modalHeaderTitle">{t["certs.modalHeaderTitle"]}</h2>
        <p class="text-sm text-[var(--app-text-muted)] mt-0.5" data-i18n="certs.modalHeaderDesc">{t["certs.modalHeaderDesc"]}</p>
      </div>
      <CloseButton id="btn-close-certs-modal" />
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto max-h-[calc(88vh-88px)] grid sm:grid-cols-2 gap-3">
      {certificates.map((cert) => <CertCard cert={cert} />)}
    </div>
  </dialog>

  <dialog id="lightbox" data-i18n-aria="lightbox.ariaLabel" aria-label={t["lightbox.ariaLabel"]} class="lightbox p-0 bg-transparent text-white max-w-none max-h-none w-screen h-[100dvh] m-0">
    <div class="h-full w-full grid grid-rows-[auto_1fr_auto] gap-3 p-3 sm:p-6">
      <div class="flex items-center justify-between gap-4 text-sm">
        <span class="font-mono text-xs text-white/60" data-lightbox-count></span>
        <button type="button" data-lightbox-close class="rounded-md px-3 py-1.5 bg-white/10 hover:bg-white/20 transition-colors cursor-pointer" data-i18n="lightbox.close">{t["lightbox.close"]}</button>
      </div>
      <figure class="min-h-0 flex flex-col items-center justify-center gap-3">
        <img data-lightbox-img alt="" class="min-h-0 max-h-full max-w-full w-auto h-auto object-contain rounded-md shadow-2xl" />
        <figcaption data-lightbox-caption class="text-sm text-white/75 text-center max-w-[70ch]"></figcaption>
      </figure>
      <div class="flex items-center justify-center gap-2" data-lightbox-nav>
        <button type="button" data-lightbox-prev class="rounded-md px-4 py-2 bg-white/10 hover:bg-white/20 transition-colors cursor-pointer" data-i18n-aria="lightbox.prev" aria-label={t["lightbox.prev"]}>&lsaquo;</button>
        <button type="button" data-lightbox-next class="rounded-md px-4 py-2 bg-white/10 hover:bg-white/20 transition-colors cursor-pointer" data-i18n-aria="lightbox.next" aria-label={t["lightbox.next"]}>&rsaquo;</button>
      </div>
    </div>
  </dialog>

  <script>
    import {
      animateTabIndicator,
      attachSquash,
      playPrimaryImpact,
      playSecondaryImpact,
      playSparkle,
      playTabImpact,
    } from "../lib/sakugaFx";

    function initWorkspace() {
      const tabNav = document.querySelector<HTMLElement>("[data-tab-nav]");
      const tabIndicator = document.querySelector<HTMLElement>("[data-tab-indicator]");
      const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]"));
      const panels = ["projects", "experience", "credentials", "stack"].map((key) => [key, document.getElementById(`tab-panel-${key}`)] as const);
      let activeIndex = 0;

      const syncIndicator = (immediate = false) => {
        const activeBtn = tabBtns[activeIndex];
        if (tabNav && tabIndicator && activeBtn) {
          animateTabIndicator(tabIndicator, activeBtn, tabNav, immediate);
        }
      };

      syncIndicator(true);
      window.addEventListener("resize", () => syncIndicator(true), { passive: true });
      new MutationObserver(() => syncIndicator(true)).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-lang"],
      });

      tabBtns.forEach((btn, idx) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.tabBtn;
          const dir = idx >= activeIndex ? 1 : -1;
          const changed = idx !== activeIndex;
          activeIndex = idx;

          tabBtns.forEach((b) => {
            const on = b.dataset.tabBtn === target;
            b.setAttribute("aria-pressed", String(on));
            b.classList.toggle("text-[var(--app-text)]", on);
            b.classList.toggle("font-bold", on);
            b.classList.toggle("text-[var(--app-text-muted)]", !on);
            b.classList.toggle("font-medium", !on);
          });
          panels.forEach(([key, panel]) => panel?.classList.toggle("hidden", key !== target));
          syncIndicator(false);
          if (changed) {
            playTabImpact(btn, dir);
            window.dispatchEvent(new CustomEvent("sakuga:tab-change"));
          }
        });
      });

      document.querySelectorAll<HTMLElement>("[data-sakuga-btn]").forEach((el) => {
        const kind = el.dataset.sakugaBtn;
        const isPrimary = kind === "primary";
        const sq = attachSquash(el, {
          low: isPrimary ? 0.86 : 0.94,
          popScale: isPrimary ? 1.06 : 1.03,
          tiltDeg: 0,
        });
        el.addEventListener("click", () => {
          sq.triggerPop();
          if (isPrimary) playPrimaryImpact(el);
          else playSecondaryImpact(el);
        });
      });

      const openModal = (dialog: HTMLDialogElement | null) => {
        if (!dialog) return;
        dialog.showModal();
        document.documentElement.classList.add("modal-open");
      };
      const modalProjects = document.getElementById("modal-all-projects") as HTMLDialogElement | null;
      const modalCerts = document.getElementById("modal-all-certs") as HTMLDialogElement | null;
      document.getElementById("btn-open-projects-modal")?.addEventListener("click", () => openModal(modalProjects));
      document.getElementById("btn-open-certs-modal")?.addEventListener("click", () => openModal(modalCerts));
      document.getElementById("btn-close-projects-modal")?.addEventListener("click", () => modalProjects?.close());
      document.getElementById("btn-close-certs-modal")?.addEventListener("click", () => modalCerts?.close());

      document.querySelectorAll<HTMLButtonElement>("[data-shot]").forEach((btn) => {
        btn.addEventListener("click", () => {
          playSparkle(btn);
        });
      });
      // Lightbox: every [data-shot] button carries its project group and index.
      const lightbox = document.getElementById("lightbox") as HTMLDialogElement | null;
      const lbImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const lbCaption = lightbox?.querySelector<HTMLElement>("[data-lightbox-caption]");
      const lbCount = lightbox?.querySelector<HTMLElement>("[data-lightbox-count]");
      const lbNav = lightbox?.querySelector<HTMLElement>("[data-lightbox-nav]");
      let group: HTMLButtonElement[] = [];
      let index = 0;
      let returnFocus: HTMLElement | null = null;

      const show = (i: number) => {
        if (!lbImg || !group.length) return;
        index = (i + group.length) % group.length;
        const btn = group[index];
        const thumb = btn.querySelector("img");
        lbImg.src = btn.dataset.full ?? "";
        lbImg.width = Number(btn.dataset.w);
        lbImg.height = Number(btn.dataset.h);
        lbImg.alt = thumb?.alt ?? "";
        if (lbCaption) lbCaption.textContent = thumb?.alt ?? "";
        if (lbCount) lbCount.textContent = group.length > 1 ? `${index + 1} / ${group.length}` : "";
        lbNav?.classList.toggle("invisible", group.length < 2);
      };

      document.querySelectorAll<HTMLButtonElement>("[data-shot]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const scope = btn.closest("[data-shot-group]") ?? btn.parentElement ?? document;
          group = Array.from(scope.querySelectorAll<HTMLButtonElement>("[data-shot]"));
          returnFocus = btn;
          show(group.indexOf(btn));
          lightbox?.showModal();
          document.documentElement.classList.add("modal-open");
        });
      });
      lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => lightbox.close());
      lightbox?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1));
      lightbox?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1));
      lightbox?.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(index - 1);
        if (e.key === "ArrowRight") show(index + 1);
      });
      lightbox?.addEventListener("click", (e) => {
        const el = e.target as HTMLElement;
        if (el === lightbox || el.tagName === "FIGURE" || el.parentElement === lightbox) lightbox.close();
      });

      [modalProjects, modalCerts, lightbox].forEach((dialog) => {
        dialog?.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });
        dialog?.addEventListener("close", () => {
          // keep scroll locked while another dialog is still open underneath
          if (!document.querySelector("dialog[open]")) document.documentElement.classList.remove("modal-open");
          if (dialog === lightbox) returnFocus?.focus();
        });
      });
    }

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initWorkspace);
    else initWorkspace();
  </script>
</Layout>
