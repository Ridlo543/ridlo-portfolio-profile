---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404"
  description="Error 404 - Page not found"
  noindex={true}
  showChrome={false}
>
  <section
    class="flex min-h-screen flex-col items-center justify-center bg-[var(--app-bg)] px-6 text-center text-[var(--app-text)]"
  >
    <h1
      class="mb-6 text-7xl font-extrabold text-[var(--app-accent)] md:text-8xl"
    >
      404
    </h1>

    <h2 class="mb-6 text-2xl font-semibold md:text-3xl">Page not found</h2>

    <p class="mx-auto mb-10 max-w-md font-bold text-[var(--app-text-muted)]">
      The page you tried to open does not exist or has moved. Return home and
      keep browsing the template.
    </p>

    <a href="/" class="modal-action modal-action--primary px-5 py-3 text-base">
      Back to home
    </a>
  </section>
</Layout>
