---
import { ui, defaultLang } from "../../i18n/ui";

interface Props {
  id: string;
}

const { id } = Astro.props;
const t = ui[defaultLang];
---

<button
  {id}
  type="button"
  data-sakuga-btn="secondary"
  class="shrink-0 rounded-full border-[1.5px] border-[var(--app-border)] bg-[var(--app-surface-raised)] px-3.5 py-1.5 text-xs font-semibold text-[var(--app-text)] hover:border-[var(--app-text)] transition-colors cursor-pointer"
  data-i18n="modal.close"
>{t["modal.close"]}</button>
