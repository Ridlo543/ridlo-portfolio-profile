---
import type { BilingualProject } from "../../i18n/content";
import { ui, defaultLang } from "../../i18n/ui";
import { FaGithub } from "react-icons/fa6";

interface Props {
  project: BilingualProject;
}

const { project } = Astro.props;
const lang = defaultLang;
const t = ui[lang];
const images = project.images ?? [];
const src = (name: string, size?: 320) => `/assets/portofolio/${name}${size ? `-${size}` : ""}.webp`;
---

<article
  class="p-4 rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/70 hover:border-[var(--app-border-strong)] transition-colors"
  data-project-item={project.id}
  data-shot-group
>
  <div class:list={["grid gap-4", images.length > 0 && "sm:grid-cols-[minmax(0,1fr)_9.5rem]"]}>
    <div class="min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-2 text-xs">
        <span class="font-medium text-[var(--app-accent)]" data-project-field="visualLabel">{project.visualLabel[lang]}</span>
        <span class="text-[var(--app-text-soft)]" aria-hidden="true">·</span>
        <span class="font-mono text-[var(--app-text-soft)]" data-project-field="year">{project.year[lang]}</span>
      </div>
      <h3 class="text-base font-semibold text-[var(--app-text)] mt-1">{project.title}</h3>
      <p class="text-sm text-[var(--app-text-muted)] leading-relaxed mt-1.5" data-project-field="description">
        {project.description[lang]}
      </p>
      <ul class="mt-3 space-y-1 pl-4 list-disc marker:text-[var(--app-text-soft)] text-[0.8rem] leading-relaxed text-[var(--app-text-muted)]" data-project-field="impact">
        {project.impact[lang].map((item) => <li>{item}</li>)}
      </ul>
    </div>

    {images.length > 0 && (
      <div class="flex sm:flex-col gap-2 order-first sm:order-none">
        {images.map((img, i) => (
          <button
            type="button"
            data-shot
            data-full={src(img.name)}
            data-w={img.width}
            data-h={img.height}
            class="shot group relative block w-36 sm:w-full overflow-hidden rounded-md border border-[var(--app-border)] bg-[var(--app-surface-muted)] cursor-zoom-in"
            data-i18n-aria="projects.enlarge"
            aria-label={t["projects.enlarge"]}
          >
            <img
              src={src(img.name, 320)}
              alt={img.alt[lang]}
              data-project-img={i}
              width="320"
              height={Math.round((320 * img.height) / img.width)}
              loading="lazy"
              decoding="async"
              class="block w-full aspect-[16/10] object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
            />
          </button>
        ))}
      </div>
    )}
  </div>


  <div class="flex flex-wrap items-center justify-between gap-3 pt-3 mt-3 border-t border-[var(--app-border)]">
    <ul class="flex flex-wrap gap-1 font-mono text-[0.68rem]">
      {project.technologies.map((tech) => (
        <li class="px-2 py-0.5 rounded bg-[var(--app-surface-muted)] text-[var(--app-text)]">{tech}</li>
      ))}
    </ul>
    <div class="flex flex-wrap items-center gap-1.5">
      {project.links.map((link, i) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-[var(--app-accent)]/30 bg-[var(--app-accent)]/10 hover:bg-[var(--app-accent)] hover:text-[var(--app-on-primary)] text-[var(--app-accent)] font-medium text-xs px-2.5 py-1 transition-colors"
        >
          {link.type === "code" && <FaGithub className="h-3.5 w-3.5" />}
          <span data-project-link={i}>{link.label[lang]}</span>
        </a>
      ))}
    </div>
  </div>
</article>
