---
import { Eye } from "lucide-react";
import { ui, defaultLang } from "../../../i18n/ui";

const t = ui[defaultLang];
---

<div class="visitor-badge" data-visitor-badge aria-label="Visitor counter">
  <Eye aria-hidden="true" className="visitor-badge__icon" />
  <span class="visitor-badge__count" data-visitor-count>...</span>
  <span class="visitor-badge__label" data-i18n="intro.visitors">{t["intro.visitors"]}</span>
</div>

<script>
  const countEl = document.querySelector("[data-visitor-count]");

  async function fetchVisitorCount() {
    try {
      const response = await fetch("/api/visitor");
      if (!response.ok) return;

      const data = await response.json();
      if (typeof data.count === "number" && countEl) {
        countEl.textContent = `${data.count.toLocaleString()}+`;
      }
    } catch {
      if (countEl) countEl.textContent = "1,099+";
    }
  }

  fetchVisitorCount();
</script>
