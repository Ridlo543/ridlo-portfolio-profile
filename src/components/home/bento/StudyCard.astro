---
import { Award, Download, X } from "lucide-react";
import { bilingualEducation } from "../../../i18n/content";
import { certificates } from "../../../data/certificateData.js";
import { ui, defaultLang } from "../../../i18n/ui";

const t = ui[defaultLang];
const featuredCertificates = certificates.slice(0, 3);
---

<div class="space-y-2.5 text-sm text-[var(--app-text-muted)]">
  <!-- Degree Preview Card -->
  <div class="space-y-2">
    <div
      class="group cursor-pointer rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/50 p-2.5 transition-all hover:border-[var(--app-accent)] hover:bg-[var(--app-surface-raised)]"
      data-open-certificates-trigger
      data-education-card
    >
      <div class="flex items-center justify-between text-[0.68rem] font-bold text-[var(--app-text-soft)]">
        <span class="rounded bg-[var(--app-surface-muted)] px-1.5 py-0.5 text-[var(--app-accent)] font-semibold">
          Bachelor Degree
        </span>
        <span class="font-bold text-[var(--app-accent)] font-mono" data-edu-field="gpa">
          {bilingualEducation.gpa[defaultLang]}
        </span>
      </div>
      <h3 class="mt-1 text-xs font-bold text-[var(--app-text)] group-hover:text-[var(--app-accent)] transition-colors" data-edu-field="title">
        {bilingualEducation.title[defaultLang]}
      </h3>
      <p class="text-[0.72rem] font-semibold text-[var(--app-text-soft)]">
        {bilingualEducation.institution[defaultLang]}
      </p>
      <p class="mt-0.5 text-[0.68rem] text-[var(--app-text-soft)]" data-edu-field="period">
        {bilingualEducation.period[defaultLang]} · {bilingualEducation.location}
      </p>
    </div>

    <!-- Featured Certificates Pills -->
    <div class="space-y-1">
      <p class="text-[0.68rem] font-bold text-[var(--app-text-soft)] uppercase tracking-wider" data-i18n="study.featured">
        {t["study.featured"]}
      </p>
      <div class="flex flex-wrap gap-1">
        {
          featuredCertificates.map((certificate) => (
            <a
              class="tag tag--compact hover:border-[var(--app-accent)]"
              href={certificate.href}
              download
              title={`Download ${certificate.title}`}
            >
              <Award className="h-3 w-3 text-[var(--app-accent)]" />
              <span class="truncate max-w-[140px]">{certificate.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Trigger to open full modal -->
  <button
    type="button"
    class="text-xs font-bold text-[var(--app-accent)] hover:underline pt-0.5 inline-block cursor-pointer"
    data-open-certificates-trigger
    data-i18n="study.viewAll"
    data-i18n-count={String(certificates.length)}
  >
    {t["study.viewAll"].replace("{count}", String(certificates.length))}
  </button>
</div>

<!-- ================= NATIVE DIALOG MODAL ================= -->
<dialog
  id="certificates-sheet"
  class="modal-shell modal-shell--certificates"
  aria-labelledby="certificates-sheet-title"
  aria-modal="true"
>
  <div class="modal-header">
    <div>
      <h2 id="certificates-sheet-title" class="modal-title" data-i18n="study.modalTitle">
        {t["study.modalTitle"]}
      </h2>
      <p class="modal-description" data-i18n="study.modalDesc">
        {t["study.modalDesc"]}
      </p>
    </div>
    <button
      type="button"
      class="icon-button modal-close shrink-0"
      data-close-certificates-sheet
      aria-label="Close certificates modal"
    >
      <X aria-hidden="true" className="h-4 w-4" />
    </button>
  </div>

  <div class="modal-content">
    <!-- University Formal Degree Card -->
    <div class="mb-3 rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)] p-3" data-education-card>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <span class="rounded bg-[var(--app-accent-soft)] px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-[var(--app-accent)]">
            Bachelor Degree
          </span>
          <h3 class="mt-2 text-base font-bold text-[var(--app-text)]" data-edu-field="title">
            {bilingualEducation.title[defaultLang]}
          </h3>
          <p class="mt-0.5 text-xs font-semibold text-[var(--app-text-muted)]">
            {bilingualEducation.institution[defaultLang]} · {bilingualEducation.location}
          </p>
          <p class="text-xs font-mono text-[var(--app-text-soft)]" data-edu-field="period">
            {bilingualEducation.period[defaultLang]}
          </p>
        </div>
        <span class="font-mono text-sm font-bold text-[var(--app-accent)]" data-edu-field="gpa">
          {bilingualEducation.gpa[defaultLang]}
        </span>
      </div>
      <p class="mt-2.5 text-xs leading-relaxed text-[var(--app-text-muted)]" data-edu-field="description">
        {bilingualEducation.description[defaultLang]}
      </p>
    </div>

    <!-- Verified Course Certificates -->
    <div class="grid gap-2.5 sm:grid-cols-2">
      {
        certificates.map((certificate) => (
          <article class="rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)] p-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[0.68rem] font-mono text-[var(--app-text-soft)]">
                <span class="text-[var(--app-accent)] font-bold uppercase">{certificate.issuer}</span>
                <span>{certificate.date}</span>
              </div>
              <h4 class="mt-1 text-xs font-bold text-[var(--app-text)] line-clamp-2">
                {certificate.title}
              </h4>
              <p class="mt-1 text-[0.72rem] leading-relaxed text-[var(--app-text-muted)] line-clamp-2">
                {certificate.description}
              </p>
            </div>

            <div class="mt-2.5 flex items-center justify-between border-t border-[var(--app-border)] pt-2 text-[0.68rem]">
              <span class="rounded bg-[var(--app-surface-muted)] px-1.5 py-0.5 font-mono text-[var(--app-text-soft)]">
                {certificate.fileType}
              </span>
              <a
                class="inline-flex items-center gap-1 font-bold text-[var(--app-accent)] hover:underline"
                href={certificate.href}
                download
              >
                <Download className="h-3 w-3" />
                <span data-i18n="study.download">{t["study.download"]}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const sheet = document.getElementById("certificates-sheet");
  const openButtons = document.querySelectorAll("[data-open-certificates-trigger]");
  const closeButtons = document.querySelectorAll("[data-close-certificates-sheet]");

  function openModal() {
    if (sheet instanceof HTMLDialogElement && !sheet.open) {
      document.documentElement.classList.add("modal-open");
      sheet.showModal();
      history.replaceState(null, "", "#credentials");
    }
  }

  function closeModal() {
    if (sheet instanceof HTMLDialogElement && sheet.open) {
      sheet.close();
      history.replaceState(null, "", window.location.pathname + window.location.search);
    }
  }

  openButtons.forEach((btn) => btn.addEventListener("click", openModal));
  closeButtons.forEach((btn) => btn.addEventListener("click", closeModal));

  sheet?.addEventListener("click", (e) => {
    if (e.target === sheet) closeModal();
  });

  sheet?.addEventListener("close", () => {
    document.documentElement.classList.remove("modal-open");
  });
</script>
