---
import { FaGithub, FaLinkedinIn } from "react-icons/fa6";
import { HiOutlineMail } from "react-icons/hi";
import profilePhoto from "../../../assets/img/profile-photo.png";
import CvDownloadMenu from "./CvDownloadMenu.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/Ridlo543",
    icon: FaGithub,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/ridlo-abdullah-ulinnuha/",
    icon: FaLinkedinIn,
  },
  {
    label: "Email",
    href: "mailto:ridloabdullahulinnuha543@gmail.com",
    icon: HiOutlineMail,
  },
];
---

<div class="relative flex h-full flex-col gap-4">
  <div class="relative z-10 flex items-start justify-between gap-4">
    <p class="text-lg font-light text-[var(--app-text)] md:text-xl">
      Hi, I am <strong class="font-black text-[var(--app-accent)]"
        >Ridlo Abdullah Ulinnuha</strong
      >.
    </p>
    <ThemeSwitch />
  </div>

  <div class="relative z-10 grid gap-3 md:grid-cols-[1fr_auto] md:items-center">
    <div class="max-w-3xl">
      <div
        class="grid gap-2 text-sm font-semibold leading-snug text-[var(--app-text-muted)] sm:grid-cols-2"
      >
        <p>
          Software Engineer working across web applications, APIs, databases,
          product interfaces, and machine learning integration.
        </p>
        <p>
          I like practical systems: code that ships, tests that catch
          regressions, and documentation that helps the next person move faster.
        </p>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {
          socials.map(({ label, href, icon: Icon }) => (
            <a
              href={href}
              target={href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              aria-label={label}
              class="icon-button"
            >
              <Icon className="h-5 w-5" />
            </a>
          ))
        }
        <CvDownloadMenu />
      </div>
    </div>

    <img
      src={profilePhoto.src}
      alt="Ridlo Abdullah Ulinnuha logo"
      class="mx-auto h-32 w-32 shrink-0 rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)] object-cover md:mx-0 lg:h-40 lg:w-40"
    />
  </div>
</div>
