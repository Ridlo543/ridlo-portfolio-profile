---
import {
  BriefcaseBusiness,
  Code,
  ExternalLink,
  LockKeyhole,
  X,
} from "lucide-react";
import { projectFilters, projects } from "../../../data/projectData.js";

const featured = projects.filter((project) => project.featured).slice(0, 3);
---

<div class="space-y-3">
  <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
    {
      featured.map((project) => (
        <article>
          <h3 class="text-sm font-black text-[var(--app-accent)]">
            {project.title}
          </h3>
          <p class="mt-1 text-sm leading-snug text-[var(--app-text-muted)]">
            {project.description}
          </p>
          <p class="mt-1 text-xs text-[var(--app-text-soft)]">
            {project.technologies.slice(0, 3).join(" / ")}
          </p>
        </article>
      ))
    }
  </div>
  <button
    type="button"
    data-open-projects
    class="text-link"
    aria-haspopup="dialog"
    aria-controls="projects-modal"
  >
    View all projects
  </button>
</div>

<dialog
  id="projects-modal"
  class="modal-shell"
  aria-labelledby="projects-modal-title"
  aria-describedby="projects-modal-description"
>
  <div class="modal-header">
    <div class="min-w-0 flex-1">
      <h2 id="projects-modal-title" class="modal-title">Projects</h2>
      <p id="projects-modal-description" class="modal-description">
        Selected production, web, mobile, and data projects from CV and GitHub.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          projectFilters.map((filter) => (
            <button
              type="button"
              data-project-filter={filter.value}
              class="modal-filter"
              data-active={filter.value === "all" ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>
    <button
      type="button"
      data-close-projects
      class="icon-button"
      aria-label="Close projects modal"
    >
      <X aria-hidden="true" className="h-4 w-4" />
    </button>
  </div>

  <div class="modal-content">
    <div class="grid gap-3 md:grid-cols-2">
      {
        projects.map((project) => (
          <article
            data-project-card
            data-categories={project.categories.join("|")}
            class="modal-card"
            style={`--project-accent: ${project.accent}`}
          >
            <div class="relative flex h-32 overflow-hidden border-b border-[var(--app-border)] bg-[var(--app-surface)] p-4">
              <div class="pointer-events-none absolute inset-0 bg-linear-to-br from-[var(--project-accent)]/20 via-transparent to-[var(--app-primary)]/10" />
              <div class="relative z-10 flex h-full w-full flex-col justify-between">
                <div class="flex items-center justify-between gap-3 text-xs font-bold uppercase tracking-wide text-[var(--project-accent)]">
                  <span>{project.visualLabel}</span>
                  <span>{project.year}</span>
                </div>
                <div>
                  <p class="text-lg font-black text-[var(--app-text)]">
                    {project.title}
                  </p>
                  <p class="mt-1 text-xs text-[var(--app-text-soft)]">
                    {project.categories
                      .map(
                        (category) =>
                          projectFilters.find(
                            (filter) => filter.value === category,
                          )?.label || category,
                      )
                      .join(" / ")}
                  </p>
                </div>
              </div>
            </div>
            <div class="space-y-3 p-4">
              <div class="flex flex-wrap items-center gap-2">
                {project.privateCase && (
                  <span class="tag">
                    <LockKeyhole aria-hidden="true" className="h-3.5 w-3.5" />
                    Private case study
                  </span>
                )}
                {project.categories.includes("professional") && (
                  <span class="tag">
                    <BriefcaseBusiness
                      aria-hidden="true"
                      className="h-3.5 w-3.5"
                    />
                    Professional work
                  </span>
                )}
              </div>
              <p class="text-sm leading-relaxed text-[var(--app-text-muted)]">
                {project.description}
              </p>
              <ul class="space-y-1 text-sm leading-relaxed text-[var(--app-text-muted)]">
                {project.impact.map((item) => (
                  <li class="list-inside list-disc">{item}</li>
                ))}
              </ul>
              <div class="flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
              {project.links.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-1">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`modal-action ${
                        link.type === "demo" ? "modal-action--primary" : ""
                      }`}
                    >
                      {link.type === "demo" ? (
                        <ExternalLink aria-hidden="true" className="h-4 w-4" />
                      ) : (
                        <Code aria-hidden="true" className="h-4 w-4" />
                      )}
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const projectsModal = document.getElementById("projects-modal");
  const openProjectsButton = document.querySelector("[data-open-projects]");
  const closeProjectsButton = document.querySelector("[data-close-projects]");
  const projectsModalContent = projectsModal?.querySelector(".modal-content");
  const filterButtons = Array.from(
    document.querySelectorAll("[data-project-filter]"),
  );
  const projectCards = Array.from(
    document.querySelectorAll("[data-project-card]"),
  );
  let projectsTrigger: HTMLElement | null = null;

  openProjectsButton?.addEventListener("click", (event) => {
    if (projectsModal instanceof HTMLDialogElement) {
      projectsTrigger =
        event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
      document.documentElement.classList.add("modal-open");
      projectsModal.showModal();
      if (projectsModalContent instanceof HTMLElement) {
        projectsModalContent.scrollTop = 0;
      }
      closeProjectsButton instanceof HTMLElement && closeProjectsButton.focus();
    }
  });

  closeProjectsButton?.addEventListener("click", () => {
    if (projectsModal instanceof HTMLDialogElement) {
      projectsModal.close();
    }
  });

  projectsModal?.addEventListener("click", (event) => {
    if (
      event.target === projectsModal &&
      projectsModal instanceof HTMLDialogElement
    ) {
      projectsModal.close();
    }
  });

  projectsModal?.addEventListener("close", () => {
    document.documentElement.classList.remove("modal-open");
    projectsTrigger?.focus();
    projectsTrigger = null;
  });

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selected = button.getAttribute("data-project-filter") || "all";

      filterButtons.forEach((item) => {
        item.setAttribute("data-active", item === button ? "true" : "false");
      });

      projectCards.forEach((card) => {
        const categories =
          card.getAttribute("data-categories")?.split("|") || [];
        card.classList.toggle(
          "hidden",
          selected !== "all" && !categories.includes(selected),
        );
      });
    });
  });
</script>
