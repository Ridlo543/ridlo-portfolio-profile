---
import { Code2, ExternalLink, LockKeyhole, X } from "lucide-react";
import { bilingualProjects } from "../../../i18n/content";
import { ui, defaultLang } from "../../../i18n/ui";

const t = ui[defaultLang];
const featured = bilingualProjects.filter((project) => project.featured).slice(0, 2);

const filterOptions = [
  { value: "all", key: "projects.filterAll" },
  { value: "professional", key: "projects.filterProfessional" },
  { value: "web", key: "projects.filterWeb" },
  { value: "mobile", key: "projects.filterMobile" },
  { value: "data-ml", key: "projects.filterDataMl" },
] as const;
---

<div class="space-y-2.5">
  <!-- Preview Rows (2 items) -->
  <div class="space-y-2">
    {
      featured.map((project) => (
        <article
          class="group cursor-pointer rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/50 p-2.5 transition-all hover:border-[var(--app-accent)] hover:bg-[var(--app-surface-raised)]"
          data-open-project-id={project.id}
          data-project-item={project.id}
        >
          <div class="flex items-center justify-between text-[0.68rem] font-bold text-[var(--app-text-soft)]">
            <span class="text-[var(--app-accent)] font-semibold" data-project-field="visualLabel">
              {project.visualLabel[defaultLang]}
            </span>
            <span data-project-field="year">{project.year[defaultLang]}</span>
          </div>
          <h3 class="mt-0.5 text-xs font-bold text-[var(--app-text)] group-hover:text-[var(--app-accent)] transition-colors line-clamp-1">
            {project.title}
          </h3>
          <p class="mt-0.5 text-[0.72rem] leading-relaxed text-[var(--app-text-muted)] line-clamp-1" data-project-field="description">
            {project.description[defaultLang]}
          </p>
          <div class="mt-1.5 flex flex-wrap gap-1">
            {project.technologies.slice(0, 3).map((tech) => (
              <span class="tag tag--compact">{tech}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <!-- Trigger to open full modal -->
  <button
    type="button"
    class="text-xs font-bold text-[var(--app-accent)] hover:underline pt-0.5 inline-block cursor-pointer"
    data-open-projects-trigger
    data-i18n="projects.viewAll"
    data-i18n-count={String(bilingualProjects.length)}
  >
    {t["projects.viewAll"].replace("{count}", String(bilingualProjects.length))}
  </button>
</div>

<!-- ================= NATIVE DIALOG MODAL ================= -->
<dialog
  id="projects-sheet"
  class="modal-shell"
  aria-labelledby="projects-sheet-title"
  aria-modal="true"
>
  <div class="modal-header">
    <div class="min-w-0 flex-1">
      <h2 id="projects-sheet-title" class="modal-title" data-i18n="projects.modalTitle">
        {t["projects.modalTitle"]}
      </h2>
      <p class="modal-description" data-i18n="projects.modalDesc">
        {t["projects.modalDesc"]}
      </p>

      <!-- Category Filter Pills -->
      <div class="mt-3 flex flex-wrap gap-1.5" role="toolbar" aria-label="Filter projects">
        {
          filterOptions.map((filter) => (
            <button
              type="button"
              data-project-filter={filter.value}
              data-i18n={filter.key}
              class="modal-filter"
              data-active={filter.value === "all" ? "true" : "false"}
            >
              {t[filter.key]}
            </button>
          ))
        }
      </div>
    </div>

    <button
      type="button"
      class="icon-button modal-close shrink-0"
      data-close-projects-sheet
      aria-label="Close projects modal"
    >
      <X aria-hidden="true" className="h-4 w-4" />
    </button>
  </div>

  <div class="modal-content">
    <div class="grid gap-3 sm:grid-cols-2">
      {
        bilingualProjects.map((project) => (
          <article
            id={`project-card-${project.id}`}
            class="modal-card p-3 flex flex-col justify-between"
            data-project-card
            data-categories={project.categories.join("|")}
            data-project-item={project.id}
          >
            <div>
              <div class="flex items-center justify-between text-[0.68rem] font-bold text-[var(--app-text-soft)]">
                <span class="text-[var(--app-accent)]" data-project-field="visualLabel">
                  {project.visualLabel[defaultLang]}
                </span>
                <span data-project-field="year">{project.year[defaultLang]}</span>
              </div>

              <h3 class="mt-1 text-sm font-bold text-[var(--app-text)]">
                {project.title}
              </h3>

              <p class="mt-1 text-xs leading-relaxed text-[var(--app-text-muted)]" data-project-field="description">
                {project.description[defaultLang]}
              </p>

              <ul class="mt-2.5 space-y-1 text-xs leading-relaxed text-[var(--app-text-muted)] pl-4 list-disc" data-project-field="impact">
                {project.impact[defaultLang].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class="mt-3 border-t border-[var(--app-border)] pt-2">
              <div class="flex flex-wrap gap-1">
                {project.technologies.map((tech) => (
                  <span class="tag tag--compact">{tech}</span>
                ))}
              </div>

              <div class="mt-2.5 flex items-center justify-between text-xs font-bold">
                <div class="flex items-center gap-2">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-[var(--app-accent)] hover:underline"
                    >
                      {link.type === "demo" ? (
                        <ExternalLink className="h-3.5 w-3.5" />
                      ) : (
                        <Code2 className="h-3.5 w-3.5" />
                      )}
                      <span>{link.label[defaultLang]}</span>
                    </a>
                  ))}
                </div>

                {project.privateCase && (
                  <span class="text-[0.68rem] text-[var(--app-text-soft)] italic flex items-center gap-1" data-i18n="projects.privateCase">
                    <LockKeyhole className="h-3 w-3" />
                    {t["projects.privateCase"]}
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const sheet = document.getElementById("projects-sheet");
  const openButtons = document.querySelectorAll("[data-open-projects-trigger]");
  const projectRowTriggers = document.querySelectorAll("[data-open-project-id]");
  const closeButtons = document.querySelectorAll("[data-close-projects-sheet]");
  const filterButtons = document.querySelectorAll("[data-project-filter]");
  const projectCards = document.querySelectorAll("[data-project-card]");

  function openModal(projectId?: string | null) {
    if (sheet instanceof HTMLDialogElement && !sheet.open) {
      document.documentElement.classList.add("modal-open");
      sheet.showModal();

      if (projectId) {
        history.replaceState(null, "", `#project-${projectId}`);
        setTimeout(() => {
          const targetCard = document.getElementById(`project-card-${projectId}`);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        }, 100);
      } else {
        history.replaceState(null, "", "#projects");
      }
    }
  }

  function closeModal() {
    if (sheet instanceof HTMLDialogElement && sheet.open) {
      sheet.close();
      history.replaceState(null, "", window.location.pathname + window.location.search);
    }
  }

  openButtons.forEach((btn) => btn.addEventListener("click", () => openModal()));
  closeButtons.forEach((btn) => btn.addEventListener("click", closeModal));

  projectRowTriggers.forEach((row) => {
    row.addEventListener("click", () => {
      const prjId = row.getAttribute("data-open-project-id");
      openModal(prjId);
    });
  });

  sheet?.addEventListener("click", (e) => {
    if (e.target === sheet) closeModal();
  });

  sheet?.addEventListener("close", () => {
    document.documentElement.classList.remove("modal-open");
  });

  // Filter functionality
  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.getAttribute("data-project-filter") || "all";

      filterButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("data-active", active ? "true" : "false");
        b.setAttribute("aria-pressed", active ? "true" : "false");
      });

      projectCards.forEach((card) => {
        const categories = card.getAttribute("data-categories")?.split("|") || [];
        const match = selected === "all" || categories.includes(selected);
        card.classList.toggle("hidden", !match);
      });
    });
  });
</script>
