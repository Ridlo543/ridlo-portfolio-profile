---
import { Moon, Sun } from "lucide-react";
---

<button
  type="button"
  class="icon-button theme-toggle"
  data-theme-toggle
  data-theme-mode="dark"
  aria-label="Toggle theme: light or dark"
  title="Toggle theme: light or dark"
>
  <Sun aria-hidden="true" className="theme-icon theme-icon-light" />
  <Moon aria-hidden="true" className="theme-icon theme-icon-dark" />
</button>

<script>
  import { attachSquash, playSparkle } from "../../../lib/sakugaFx";

  const storageKey = "portfolio-theme";
  const defaultTheme = "light";
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function getStoredTheme(): "dark" | "light" {
    try {
      const stored = localStorage.getItem(storageKey);
      return stored === "light" || stored === "dark" ? stored : defaultTheme;
    } catch {
      return defaultTheme;
    }
  }

  function applyTheme(theme: "dark" | "light") {
    const root = document.documentElement;
    root.dataset.themeMode = theme;
    root.dataset.theme = theme;
    root.classList.remove("dark", "light");
    root.classList.add(theme);

    button?.setAttribute("data-theme-mode", theme);
    button?.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
    button?.setAttribute("title", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
  }

  if (button) {
    const sq = attachSquash(button, { low: 0.84, popScale: 1.14, tiltDeg: -6 });
    button.addEventListener("click", () => {
      const currentTheme = getStoredTheme();
      const nextTheme = currentTheme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(storageKey, nextTheme);
      } catch {}
      applyTheme(nextTheme);
      sq.triggerPop();
      playSparkle(button);
    });
  }

  applyTheme(getStoredTheme());
</script>
