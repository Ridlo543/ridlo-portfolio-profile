---
import { FaGithub } from "react-icons/fa6";
import { Mail } from "lucide-react";
---

<div
  class="flex h-full flex-col justify-center gap-4 text-center text-sm text-[var(--app-text-muted)]"
>
  <p>
    Reach out for collaboration, freelance work, or to adapt this template into
    a personal portfolio.
  </p>
  <div class="flex flex-wrap justify-center gap-2">
    <a
      href="mailto:hello@example.com"
      class="modal-action modal-action--primary"
    >
      <Mail aria-hidden="true" className="h-4 w-4" />
      Email
    </a>
    <a
      href="https://github.com/Lautaro-R-collins"
      target="_blank"
      rel="noopener noreferrer"
      class="modal-action"
    >
      <FaGithub aria-hidden="true" className="h-4 w-4" />
      GitHub
    </a>
  </div>
</div>
