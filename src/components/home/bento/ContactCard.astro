---
import { FaGithub, FaLinkedinIn } from "react-icons/fa6";
import { Mail } from "lucide-react";
---

<div
  class="flex flex-col items-center justify-between gap-2.5 text-center text-xs text-[var(--app-text-muted)] sm:flex-row sm:text-left py-0.5"
>
  <div class="space-y-0.5">
    <h3 class="text-xs font-bold text-[var(--app-text)]">
      Let's Connect & Build Together
    </h3>
    <p class="text-[0.72rem] text-[var(--app-text-soft)]">
      Available for software engineering roles, technical collaboration, and open discussions.
    </p>
  </div>

  <div class="flex shrink-0 flex-wrap justify-center gap-1.5">
    <a
      href="mailto:ridloabdullahulinnuha543@gmail.com"
      class="modal-action modal-action--primary text-xs py-1 px-2.5"
    >
      <Mail aria-hidden="true" className="h-3.5 w-3.5" />
      <span>Email</span>
    </a>
    <a
      href="https://www.linkedin.com/in/ridlo-abdullah-ulinnuha/"
      target="_blank"
      rel="noopener noreferrer"
      class="modal-action text-xs py-1 px-2.5"
    >
      <FaLinkedinIn aria-hidden="true" className="h-3.5 w-3.5" />
      <span>LinkedIn</span>
    </a>
    <a
      href="https://github.com/Ridlo543"
      target="_blank"
      rel="noopener noreferrer"
      class="modal-action text-xs py-1 px-2.5"
    >
      <FaGithub aria-hidden="true" className="h-3.5 w-3.5" />
      <span>GitHub</span>
    </a>
  </div>
</div>
