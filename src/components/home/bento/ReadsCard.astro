---
const notes = [
  "Designing interfaces that stay readable at every viewport.",
  "Building reusable data-driven cards in Astro.",
  "Keeping portfolio content concise, useful, and easy to replace.",
];
---

<div class="space-y-4">
  <p class="text-sm leading-relaxed text-[var(--app-text-muted)]">
    Placeholder notes for writing, reading, or learning highlights.
  </p>
  <ul class="space-y-2 text-sm text-[var(--app-text)]">
    {notes.map((note) => <li class="list-inside list-disc">{note}</li>)}
  </ul>
</div>
