---
const notes = [
  "Production web applications and API integrations.",
  "Database reliability, testing, and performance work.",
  "Applied ML prototypes, documentation, and product handoff.",
];
---

<div class="space-y-3">
  <p class="text-sm leading-relaxed text-[var(--app-text-muted)]">
    Current technical focus across work, university, and independent projects.
  </p>
  <ul class="space-y-1.5 text-sm leading-relaxed text-[var(--app-text)]">
    {notes.map((note) => <li class="list-inside list-disc">{note}</li>)}
  </ul>
</div>
