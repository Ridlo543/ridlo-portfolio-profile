---
import { GitPullRequest, Gauge, GraduationCap, Zap } from "lucide-react";
import { ui, defaultLang } from "../../../i18n/ui";

const t = ui[defaultLang];

const metrics = [
  {
    value: "227+",
    labelKey: "about.metric1.label",
    descKey: "about.metric1.desc",
    icon: GitPullRequest,
  },
  {
    value: "40%",
    labelKey: "about.metric2.label",
    descKey: "about.metric2.desc",
    icon: Zap,
  },
  {
    value: "3.75",
    labelKey: "about.metric3.label",
    descKey: "about.metric3.desc",
    icon: GraduationCap,
  },
  {
    value: "95+",
    labelKey: "about.metric4.label",
    descKey: "about.metric4.desc",
    icon: Gauge,
  },
] as const;
---

<div class="flex h-full flex-col justify-between gap-2 text-sm">
  <div class="grid grid-cols-2 gap-2">
    {
      metrics.map((m) => {
        const Icon = m.icon;
        return (
          <div class="rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/80 p-2 transition-colors hover:border-[var(--app-border-strong)]">
            <div class="flex items-center justify-between">
              <span class="text-base font-black text-[var(--app-accent)] font-mono">
                {m.value}
              </span>
              <Icon className="h-3 w-3 text-[var(--app-text-soft)]" />
            </div>
            <p class="mt-0.5 text-[0.72rem] font-bold text-[var(--app-text)] leading-tight" data-i18n={m.labelKey}>
              {t[m.labelKey]}
            </p>
            <p class="text-[0.65rem] text-[var(--app-text-soft)] leading-tight" data-i18n={m.descKey}>
              {t[m.descKey]}
            </p>
          </div>
        );
      })
    }
  </div>

  <div class="flex flex-wrap items-center gap-1.5 border-t border-[var(--app-border)] pt-2 text-[0.7rem] font-semibold">
    <span class="rounded bg-[var(--app-surface-muted)] px-2 py-0.5 text-[var(--app-text-muted)]" data-i18n="about.tag1">
      {t["about.tag1"]}
    </span>
    <span class="rounded bg-[var(--app-surface-muted)] px-2 py-0.5 text-[var(--app-text-muted)]" data-i18n="about.tag2">
      {t["about.tag2"]}
    </span>
    <span class="rounded bg-[var(--app-surface-muted)] px-2 py-0.5 text-[var(--app-text-muted)]" data-i18n="about.tag3">
      {t["about.tag3"]}
    </span>
  </div>
</div>
