---
const skills = [
  "Astro",
  "React",
  "TypeScript",
  "JavaScript",
  "Tailwind CSS",
  "Node.js",
  "Express",
  "MongoDB",
  "REST APIs",
  "UI Systems",
];
---

<div class="space-y-4 text-sm leading-relaxed text-[var(--app-text-muted)]">
  <p class="text-[var(--app-text-soft)]">Build, learn, ship, and improve.</p>
  <p class="font-semibold text-[var(--app-text)]">
    I enjoy turning product ideas into clean web experiences and practical
    software systems.
  </p>
  <p>
    Use this card to summarize your strongest value: how you think, what you
    build, and how you help teams move from idea to working product.
  </p>

  <div class="border-t border-[var(--app-border)] pt-4">
    <p
      class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--app-accent)]"
    >
      Technologies
    </p>
    <ul
      class="grid grid-cols-1 gap-1 text-[var(--app-text-muted)] sm:grid-cols-2 lg:grid-cols-1"
    >
      {skills.map((skill) => <li class="list-inside list-disc">{skill}</li>)}
    </ul>
  </div>

  <p class="text-xs text-[var(--app-text-soft)]">
    Use the project and experience cards to open focused modal views without
    leaving this page.
  </p>
</div>
