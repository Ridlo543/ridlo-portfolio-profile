---
import { X } from "lucide-react";
import { jobs } from "../../../data/jobsData.js";

const recentJobs = jobs.slice(0, 3);
---

<div class="space-y-5">
  {
    recentJobs.map((job) => (
      <article>
        <h3 class="text-sm font-black text-[var(--app-text)]">{job.title}</h3>
        <p class="mt-1 line-clamp-2 text-sm font-semibold text-[var(--app-accent)]">
          {job.description}
        </p>
        <p class="mt-1 text-xs text-[var(--app-text-soft)]">
          {job.time.join(" / ")}
        </p>
      </article>
    ))
  }
  <button
    type="button"
    data-open-experience
    class="text-link"
    aria-haspopup="dialog"
    aria-controls="experience-modal"
  >
    View full experience
  </button>
</div>

<dialog
  id="experience-modal"
  class="modal-shell modal-shell--experience"
  aria-labelledby="experience-modal-title"
  aria-describedby="experience-modal-description"
>
  <div class="modal-header">
    <div>
      <h2 id="experience-modal-title" class="modal-title">Experience</h2>
      <p id="experience-modal-description" class="modal-description">
        A compact timeline of selected work.
      </p>
    </div>
    <button
      type="button"
      data-close-experience
      class="icon-button"
      aria-label="Close experience modal"
    >
      <X aria-hidden="true" className="h-4 w-4" />
    </button>
  </div>

  <div class="modal-content">
    <div class="space-y-6">
      {
        jobs.map((job) => (
          <article class="relative border-l border-[var(--app-border)] pl-5">
            <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border border-[var(--app-accent)] bg-[var(--app-surface)]" />
            <h3 class="text-base font-black text-[var(--app-text)]">
              {job.title}
            </h3>
            <p class="mt-1 text-xs text-[var(--app-text-soft)]">
              {job.time.join(" / ")}
            </p>
            <p class="mt-3 text-sm font-semibold leading-relaxed text-[var(--app-accent)]">
              {job.description}
            </p>
            <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-[var(--app-text-muted)]">
              {job.list.map((item) => (
                <li class="list-inside list-disc">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const experienceModal = document.getElementById("experience-modal");
  const openExperienceButton = document.querySelector("[data-open-experience]");
  const closeExperienceButton = document.querySelector(
    "[data-close-experience]",
  );
  let experienceTrigger: HTMLElement | null = null;

  openExperienceButton?.addEventListener("click", (event) => {
    if (experienceModal instanceof HTMLDialogElement) {
      experienceTrigger =
        event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
      document.documentElement.classList.add("modal-open");
      experienceModal.showModal();
      closeExperienceButton instanceof HTMLElement &&
        closeExperienceButton.focus();
    }
  });

  closeExperienceButton?.addEventListener("click", () => {
    if (experienceModal instanceof HTMLDialogElement) {
      experienceModal.close();
    }
  });

  experienceModal?.addEventListener("click", (event) => {
    if (
      event.target === experienceModal &&
      experienceModal instanceof HTMLDialogElement
    ) {
      experienceModal.close();
    }
  });

  experienceModal?.addEventListener("close", () => {
    document.documentElement.classList.remove("modal-open");
    experienceTrigger?.focus();
    experienceTrigger = null;
  });
</script>
