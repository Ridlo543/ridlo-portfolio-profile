---
import { Calendar, X } from "lucide-react";
import { bilingualExperiences } from "../../../i18n/content";
import { ui, defaultLang } from "../../../i18n/ui";

const t = ui[defaultLang];
const recentJobs = bilingualExperiences.slice(0, 2);
---

<div class="space-y-2.5">
  <!-- Preview Rows (2 items) -->
  <div class="space-y-2">
    {
      recentJobs.map((job) => (
        <article
          class="group cursor-pointer rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/50 p-2.5 transition-all hover:border-[var(--app-accent)] hover:bg-[var(--app-surface-raised)]"
          data-open-experience-item
          data-experience-item={job.id}
        >
          <div class="flex items-center justify-between text-[0.68rem] font-bold text-[var(--app-text-soft)]">
            <span class="rounded bg-[var(--app-surface-muted)] px-1.5 py-0.5 text-[var(--app-accent)] font-semibold" data-exp-field="badge">
              {job.badge[defaultLang]}
            </span>
            <span data-exp-field="time">{job.time[defaultLang]}</span>
          </div>
          <h3 class="mt-1 text-xs font-bold text-[var(--app-text)] group-hover:text-[var(--app-accent)] transition-colors" data-exp-field="role">
            {job.role[defaultLang]}
          </h3>
          <p class="text-[0.72rem] font-semibold text-[var(--app-text-soft)]">
            {job.organization}
          </p>
          <p class="mt-0.5 text-[0.72rem] leading-relaxed text-[var(--app-text-muted)] line-clamp-1" data-exp-field="description">
            {job.description[defaultLang]}
          </p>
        </article>
      ))
    }
  </div>

  <!-- Trigger to open full modal -->
  <button
    type="button"
    class="text-xs font-bold text-[var(--app-accent)] hover:underline pt-0.5 inline-block cursor-pointer"
    data-open-experience-trigger
    data-i18n="experience.viewAll"
    data-i18n-count={String(bilingualExperiences.length)}
  >
    {t["experience.viewAll"].replace("{count}", String(bilingualExperiences.length))}
  </button>
</div>

<!-- ================= NATIVE DIALOG MODAL ================= -->
<dialog
  id="experience-sheet"
  class="modal-shell modal-shell--experience"
  aria-labelledby="experience-sheet-title"
  aria-modal="true"
>
  <div class="modal-header">
    <div>
      <h2 id="experience-sheet-title" class="modal-title" data-i18n="experience.modalTitle">
        {t["experience.modalTitle"]}
      </h2>
      <p class="modal-description" data-i18n="experience.modalDesc">
        {t["experience.modalDesc"]}
      </p>
    </div>
    <button
      type="button"
      class="icon-button modal-close shrink-0"
      data-close-experience-sheet
      aria-label="Close experience modal"
    >
      <X aria-hidden="true" className="h-4 w-4" />
    </button>
  </div>

  <div class="modal-content">
    <div class="relative space-y-6 before:absolute before:bottom-2 before:left-[7px] before:top-2 before:w-[2px] before:bg-[var(--app-border)]">
      {
        bilingualExperiences.map((job) => (
          <article class="relative pl-7" data-experience-item={job.id}>
            <span class="absolute left-0 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-[var(--app-accent)] bg-[var(--app-surface)]" />

            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded bg-[var(--app-accent-soft)] px-2 py-0.5 text-[0.68rem] font-bold text-[var(--app-accent)]" data-exp-field="badge">
                {job.badge[defaultLang]}
              </span>
              <span class="flex items-center gap-1 text-xs font-mono text-[var(--app-text-soft)]">
                <Calendar className="h-3 w-3" />
                <span data-exp-field="time">{job.time[defaultLang]}</span>
              </span>
            </div>

            <h3 class="mt-1 text-base font-bold text-[var(--app-text)]" data-exp-field="role">
              {job.role[defaultLang]}
            </h3>
            <p class="text-xs font-semibold text-[var(--app-text-muted)]">
              {job.organization} · {job.location}
            </p>

            <p class="mt-2 text-xs font-medium text-[var(--app-accent)]" data-exp-field="description">
              {job.description[defaultLang]}
            </p>

            <ul class="mt-2 space-y-1 text-xs leading-relaxed text-[var(--app-text-muted)] pl-4 list-disc" data-exp-field="list">
              {job.list[defaultLang].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const sheet = document.getElementById("experience-sheet");
  const openButtons = document.querySelectorAll("[data-open-experience-trigger]");
  const previewItems = document.querySelectorAll("[data-open-experience-item]");
  const closeButtons = document.querySelectorAll("[data-close-experience-sheet]");

  function openModal() {
    if (sheet instanceof HTMLDialogElement && !sheet.open) {
      document.documentElement.classList.add("modal-open");
      sheet.showModal();
      history.replaceState(null, "", "#experience");
    }
  }

  function closeModal() {
    if (sheet instanceof HTMLDialogElement && sheet.open) {
      sheet.close();
      history.replaceState(null, "", window.location.pathname + window.location.search);
    }
  }

  openButtons.forEach((btn) => btn.addEventListener("click", openModal));
  previewItems.forEach((item) => item.addEventListener("click", openModal));
  closeButtons.forEach((btn) => btn.addEventListener("click", closeModal));

  sheet?.addEventListener("click", (e) => {
    if (e.target === sheet) closeModal();
  });

  sheet?.addEventListener("close", () => {
    document.documentElement.classList.remove("modal-open");
  });
</script>
