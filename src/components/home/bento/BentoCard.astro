---
interface Props {
  title?: string;
  span?: string;
  className?: string;
}

const { title, span = "", className = "" } = Astro.props;
---

<section class={`bento-card p-3 md:p-3.5 ${span} ${className}`}>
  <div class="relative z-10">
    {title && <h2 class="bento-card-title">{title}</h2>}
    <slot />
  </div>
</section>
