---
import {
  SiAndroid,
  SiAstro,
  SiClaude,
  SiCoreldraw,
  SiDart,
  SiDocker,
  SiFigma,
  SiFilament,
  SiFlask,
  SiFlutter,
  SiGithub,
  SiGithubpages,
  SiGooglecloud,
  SiJavascript,
  SiJetpackcompose,
  SiJupyter,
  SiKotlin,
  SiLaravel,
  SiMysql,
  SiNextdotjs,
  SiPandas,
  SiPhp,
  SiPodman,
  SiPostgresql,
  SiPostman,
  SiPrisma,
  SiPython,
  SiReact,
  SiStreamlit,
  SiTailwindcss,
  SiTensorflow,
  SiTypescript,
  SiVuedotjs,
  SiWhatsapp,
  SiYolo,
} from "react-icons/si";
import { RiOpenaiFill } from "react-icons/ri";
import { BrainCircuit, Braces, Network, Terminal, Workflow, Zap } from "lucide-react";

type TechnologyItem = {
  label: string;
  color: string;
  icon?: any;
  logo?: string;
};

type TechnologyRow = {
  label: string;
  ariaLabel: string;
  className: string;
  items: TechnologyItem[];
};

// 1. Web, Backend, Database & Frontend
const webBackendItems: TechnologyItem[] = [
  { label: "Laravel", icon: SiLaravel, color: "#e32917" },
  { label: "PHP", icon: SiPhp, color: "#777bb4" },
  { label: "Filament", icon: SiFilament, color: "#f59e0b" },
  { label: "MySQL", icon: SiMysql, color: "#4479a1" },
  { label: "PostgreSQL", icon: SiPostgresql, color: "#4169e1" },
  { label: "Prisma", icon: SiPrisma, color: "var(--app-text)" },
  { label: "REST API", icon: Braces, color: "#0f766e" },
  { label: "Postman", icon: SiPostman, color: "#ff6c37" },
  { label: "WhatsApp API", icon: SiWhatsapp, color: "#128c7e" },
  { label: "JavaScript", icon: SiJavascript, color: "#f7df1e" },
  { label: "TypeScript", icon: SiTypescript, color: "#3178c6" },
  { label: "React", icon: SiReact, color: "#087ea4" },
  { label: "Vue.js", icon: SiVuedotjs, color: "#42b883" },
  { label: "Next.js", icon: SiNextdotjs, color: "var(--app-text)" },
  { label: "Astro", icon: SiAstro, color: "#bc52ee" },
  { label: "Tailwind CSS", icon: SiTailwindcss, color: "#0f766e" },
  { label: "GitHub Pages", icon: SiGithubpages, color: "var(--app-text)" },
];

// 2. Data, Machine Learning, AI Agents & Tooling (Context Engineering removed!)
const dataAiItems: TechnologyItem[] = [
  { label: "Claude Code", icon: SiClaude, color: "#d97757" },
  { label: "Oh My Pi", logo: "/logos/oh-my-pi.svg", color: "#ed4abf" },
  { label: "OpenCode", logo: "/logos/opencode.svg", color: "#22d3ee" },
  { label: "AI Agent Orchestration", icon: Workflow, color: "#c084fc" },
  { label: "Custom LLM Router", icon: Zap, color: "#38bdf8" },
  { label: "CLI Proxy API", icon: Terminal, color: "#34d399" },
  { label: "MCP Server", icon: Network, color: "#5eead4" },
  { label: "Codex", icon: RiOpenaiFill, color: "#10a37f" },
  { label: "skills.sh", logo: "/logos/skills.ico", color: "#f8fafc" },
  { label: "9Router", logo: "/logos/9router.svg", color: "#e68a6e" },
  { label: "Python", icon: SiPython, color: "#3776ab" },
  { label: "Machine Learning", icon: BrainCircuit, color: "#a78bfa" },
  { label: "TensorFlow", icon: SiTensorflow, color: "#ff6f00" },
  { label: "YOLO", icon: SiYolo, color: "#00d1d1" },
  { label: "Vertex AI", icon: SiGooglecloud, color: "#4285f4" },
  { label: "Pandas", icon: SiPandas, color: "#38bdf8" },
  { label: "Jupyter", icon: SiJupyter, color: "#f37626" },
  { label: "Flask API", icon: SiFlask, color: "var(--app-text)" },
  { label: "Streamlit", icon: SiStreamlit, color: "#d92626" },
];

// 3. Mobile, DevOps, Containers & Creative Design
const mobileDevopsToolsItems: TechnologyItem[] = [
  { label: "Kotlin", icon: SiKotlin, color: "#7f52ff" },
  { label: "Android", icon: SiAndroid, color: "#3ddc84" },
  { label: "Jetpack Compose", icon: SiJetpackcompose, color: "#4285f4" },
  { label: "Flutter", icon: SiFlutter, color: "#02569b" },
  { label: "Dart", icon: SiDart, color: "#0175c2" },
  { label: "Docker", icon: SiDocker, color: "#2496ed" },
  { label: "Podman", icon: SiPodman, color: "#892ca0" },
  { label: "Git / GitHub", icon: SiGithub, color: "var(--app-text)" },
  { label: "Figma", icon: SiFigma, color: "#f24e1e" },
  { label: "CorelDRAW", icon: SiCoreldraw, color: "#47a141" },
  { label: "Affinity Designer", logo: "/logos/affinity-designer.svg", color: "#38bdf8" },
];

const categories: TechnologyRow[] = [
  {
    label: "Backend & Systems",
    ariaLabel: "Backend and database technologies",
    className: "",
    items: webBackendItems.filter((i) =>
      ["Laravel", "PHP", "Filament", "MySQL", "PostgreSQL", "Prisma", "REST API", "WhatsApp API"].includes(i.label)
    ),
  },
  {
    label: "Frontend & Web",
    ariaLabel: "Frontend and web engineering",
    className: "",
    items: webBackendItems.filter((i) =>
      ["TypeScript", "Next.js", "React", "JavaScript", "Tailwind CSS", "Astro", "Vue.js"].includes(i.label)
    ),
  },
  {
    label: "AI & Machine Learning",
    ariaLabel: "Machine learning, data, and AI technologies",
    className: "",
    items: dataAiItems.filter((i) =>
      ["Python", "TensorFlow", "YOLO", "Vertex AI", "Pandas", "Jupyter", "Flask API", "MCP Server", "AI Agent Orchestration"].includes(i.label)
    ),
  },
  {
    label: "Mobile & DevOps",
    ariaLabel: "Mobile, DevOps, containers, and tools",
    className: "",
    items: mobileDevopsToolsItems.filter((i) =>
      ["Kotlin", "Android", "Jetpack Compose", "Flutter", "Dart", "Docker", "Git / GitHub", "Figma"].includes(i.label)
    ),
  },
];
---

<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4 text-xs" aria-label="Technology stack">
  {
    categories.map((category) => (
      <div class="flex flex-col rounded-lg border border-[var(--app-border)] bg-[var(--app-surface-raised)]/60 p-2.5 transition-colors hover:border-[var(--app-border-strong)]">
        <div class="mb-2 flex items-center justify-between border-b border-[var(--app-border)] pb-1.5">
          <span class="font-mono text-[0.68rem] font-bold tracking-tight text-[var(--app-text)]">
            {category.label}
          </span>
          <span class="font-mono text-[0.62rem] text-[var(--app-text-soft)]">
            {category.items.length}
          </span>
        </div>
        <div class="flex flex-wrap gap-1">
          {category.items.map(({ label, icon: Icon, logo, color }) => (
            <span
              class="inline-flex items-center gap-1 rounded border border-[var(--app-border)] bg-[var(--app-surface)]/80 px-1.5 py-0.5 text-[0.68rem] font-medium text-[var(--app-text)] transition-colors hover:border-[var(--app-border-strong)]"
            >
              {logo ? (
                <img src={logo} alt="" loading="lazy" class="h-3 w-3 object-contain shrink-0" />
              ) : (
                Icon && <Icon aria-hidden="true" className="h-3 w-3 shrink-0" style={{ color }} />
              )}
              <span class="truncate">{label}</span>
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
