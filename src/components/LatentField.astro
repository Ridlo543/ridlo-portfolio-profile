---
// Soft circular flashlight spotlight that follows the mouse pointer.
---

<div
  id="latent-field"
  class="spotlight-bg fixed inset-0 z-0 pointer-events-none opacity-75 transition-opacity duration-300"
  aria-hidden="true"
></div>

<style>
  .spotlight-bg {
    --spot-x: 32vw;
    --spot-y: 35vh;
    background:
      radial-gradient(
        520px circle at var(--spot-x) var(--spot-y),
        rgb(143 141 247 / 0.16),
        rgb(255 95 168 / 0.07) 38%,
        transparent 72%
      );
  }

  :global(:root[data-theme="dark"]) .spotlight-bg {
    background:
      radial-gradient(
        520px circle at var(--spot-x) var(--spot-y),
        rgb(143 141 247 / 0.22),
        rgb(255 95 168 / 0.1) 38%,
        transparent 72%
      );
  }
</style>

<script>
  function startSpotlight() {
    const el = document.getElementById("latent-field");
    if (!el) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      el.style.opacity = "0.7";
      return;
    }

    let tx = window.innerWidth * 0.5;
    let ty = window.innerHeight * 0.3;
    let cx = tx;
    let cy = ty;
    let raf = 0;
    let active = false;

    const render = () => {
      cx += (tx - cx) * 0.18;
      cy += (ty - cy) * 0.18;
      el.style.setProperty("--spot-x", `${cx.toFixed(1)}px`);
      el.style.setProperty("--spot-y", `${cy.toFixed(1)}px`);

      if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) {
        raf = requestAnimationFrame(render);
      } else {
        raf = 0;
      }
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        tx = e.clientX;
        ty = e.clientY;
        if (!active) {
          active = true;
          cx = tx;
          cy = ty;
          el.style.setProperty("--spot-x", `${cx.toFixed(1)}px`);
          el.style.setProperty("--spot-y", `${cy.toFixed(1)}px`);
          el.style.opacity = "1";
        }
        if (!raf) raf = requestAnimationFrame(render);
      },
      { passive: true },
    );

    document.documentElement.addEventListener("pointerleave", () => {
      active = false;
      el.style.opacity = "0.55";
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startSpotlight);
  } else {
    startSpotlight();
  }
</script>
